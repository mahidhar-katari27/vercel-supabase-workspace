# Credentials template — copy to .env.local and fill in.
# .env.local is gitignored; .env.example is safe to commit.

# --- Vercel (secret) --------------------------------------------------------
# Personal Access Token: https://vercel.com/account/tokens
# Use VERCEL_TEAM_ID, NOT VERCEL_ORG_ID — the latter is reserved by the CLI and
# breaks every command unless VERCEL_PROJECT_ID is also set.
VERCEL_TOKEN=vcp_your_token_here
VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase ---------------------------------------------------------------
# Project ref is EXACTLY 20 lowercase alphanumeric characters, e.g.
#   https://abcdefghijklmnopqrst.supabase.co
# Anon key: Project Settings -> API Keys -> anon public (safe to expose IF RLS
# is on). Never ship a service_role key to a browser.
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key

# 🔒 SERVER-SIDE ONLY. Bypasses Row Level Security on every table, user and
# bucket. Opaque key (no expiry) — valid until revoked in the dashboard.
# Never prefix it with NEXT_PUBLIC_; that publishes it to every visitor.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Optional framework mirrors (Next.js / Vite) — keep in sync with the above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps Platform — browser-safe key, inlined into client JS by Next.
# Leave empty to run AgriSmart's labelled demo map (no breakage).
# Enable: Maps JavaScript API, Places API, Geocoding API. Restrict by HTTP
# referrers + API list before going live. See agrismart/docs/google-maps.md.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
